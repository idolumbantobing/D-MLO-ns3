# Ignore everything by default
/*

# Keep gitignore itself
!.gitignore

# Keep required project files
!subdir/
!scratch-simulator.cc
!CMakeLists.txt

# Allow these directories to exist in git
!Graphs/
!Graphs/wifi7-roaming/
!Graphs/wifi8-roaming/

!scratch/
!scratch/Results_Complete/
!scratch/Results_Complete/dmlo_mode1/
!scratch/Results_Complete/dmlo_mode2/
!scratch/Results_Complete/dmlo_mode3/
!scratch/Results_Complete/dmlo_mode4/
!scratch/Results_Complete/mlo7/
!scratch/Results_Complete/Graphs/
!scratch/Results_Complete/Graphs/roaming-combined-5-data/
!scratch/Results_Complete/old/

# Ignore contents of specific folders
Graphs/wifi7-roaming/*
Graphs/wifi8-roaming/*

scratch/Results_Complete/dmlo_mode1/assoc-rxpower-logs/*
scratch/Results_Complete/dmlo_mode1/result-logs/*

scratch/Results_Complete/dmlo_mode2/assoc-rxpower-logs/*
scratch/Results_Complete/dmlo_mode2/result-logs/*

scratch/Results_Complete/dmlo_mode3/assoc-rxpower-logs/*
scratch/Results_Complete/dmlo_mode3/result-logs/*

scratch/Results_Complete/dmlo_mode4/assoc-rxpower-logs/*
scratch/Results_Complete/dmlo_mode4/result-logs/*

scratch/Results_Complete/mlo7/assoc-rxpower-logs/*
scratch/Results_Complete/mlo7/result-logs/*

scratch/Results_Complete/Graphs/roaming-combined-5-data/*

scratch/Results_Complete/old/*
